# AI service — copy to .env before docker compose up
# All variables below are required unless noted.

AI_PORT=8082
QDRANT_PORT=6333
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=recipe_chunks

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Internal core↔ai secrets (both derived from core's AI_SERVICE_TOKEN).
# AI_SERVICE_TOKEN_HASH: SHA-256 hash of the shared secret — verifies inbound core→ai calls; ai
#   never stores the plaintext. Generate with:
#     python -c "import hashlib,sys;print(hashlib.sha256(sys.argv[1].encode()).hexdigest())" <token>
#   (value below is the hash of "babaai-ai-service-token").
# CORE_SERVICE_TOKEN: raw secret sent on outbound ai→core calls (recipe ingest); must equal core AI_SERVICE_TOKEN.
AI_SERVICE_TOKEN_HASH=85f6e9f128c50ef22c53a37d12fbed4fa6c0e7b2f3a56bc72b5b4b68cba8def6
CORE_SERVICE_TOKEN=babaai-ai-service-token

CORE_JWKS_URL=http://host.docker.internal:8081/.well-known/jwks.json
CORE_BASE_URL=http://host.docker.internal:8081

OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2
OLLAMA_PORT=11434
# Per-request timeout in seconds (fail fast; the caller degrades gracefully).
OLLAMA_TIMEOUT_SECONDS=45
# Keep the model resident between calls (avoids cold-load each request). e.g. 30m, 1h, -1 (forever).
OLLAMA_KEEP_ALIVE=30m
# Cap generated tokens to bound latency; 0 = no cap. Lower (e.g. 600) = faster but may truncate.
OLLAMA_NUM_PREDICT=0

AGENTS_ENABLED=false
RAG_ENABLED=true
CRAWLER_ENABLED=false
DEFAULT_AGENT_ID=ollama-local
CRAWLER_TIMEZONE=Europe/Sofia
CRAWLER_ALLOW_FORCE=false

# Optional — paid LLM providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional — premium tier routing + daily token quota (defaults shown)
# AI_PRO_PERMISSION=AI_PRO_SUGGESTIONS
# PREMIUM_AGENT_ID=openai-primary
# PREMIUM_DAILY_TOKEN_QUOTA=100000

# Optional — override bundled JSON config paths
# AGENTS_CONFIG_PATH=config/agents.json
# RAG_CONFIG_PATH=config/rag.json
# CRAWLERS_CONFIG_PATH=config/crawlers.json
# PROMPTS_CONFIG_PATH=config/prompts.json
